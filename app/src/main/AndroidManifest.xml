<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="PackageVisibilityPolicy,QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:maxSdkVersion="36"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.USE_LOOPBACK_INTERFACE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".KeiOSApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher_android"
        android:roundIcon="@mipmap/ic_launcher_round_android"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.KeiOS">

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            screenOrientation is a phone-only declaration now, and deliberately kept as one.

            From targetSdk 36 Android ignores an activity's orientation request on any display whose smallest
            width is >= 600dp, and targetSdk 37 removes PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY, the
            opt-out. So on a tablet this line does nothing and the app rotates freely, which is why the
            large-screen layout work exists at all. On a phone (sw < 600dp) it still applies, and it should:
            the app is designed portrait-first and has no phone landscape design beyond the compact hero.
            Changing this to fullUser would not improve the tablet — it is already unrestricted there — it
            would only unlock a phone geometry nothing is drawn for.

            There is deliberately no android:resizableActivity here: the attribute no longer exists at
            compileSdk 37 and adding it fails the build with "attribute android:resizableActivity not found".
            Nothing to opt into — resizability is simply what large screens do now.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:enableOnBackInvokedCallback="true"
            android:launchMode="singleTop"
            android:screenOrientation="sensorPortrait"
            android:windowSoftInputMode="adjustResize"
            android:exported="true" />

        <activity-alias
            android:name=".LauncherAppleDesigns"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_apple"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round_apple"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherAndroidDesigns"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_android"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round_android"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".core.shortcut.AppShortcutActionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.KeiOS.ShortcutAction" />

        <!--
            The daily tiles' long-press target.

            Android resolves TileService.ACTION_QS_TILE_PREFERENCES against the tile's own package on a
            long-press and only falls back to the system app-info screen when nothing handles it, which is
            what these tiles did before this activity existed. exported must be true for SystemUI to launch
            it; the activity treats its intent as untrusted and only reads which tile was pressed from it.

            No screenOrientation: it opens from the shade and should follow whatever the device is doing.
        -->
        <activity
            android:name=".ui.page.main.ba.BaDailyDoneTemplateActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:enableOnBackInvokedCallback="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/ba_daily_template_title"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.KeiOS.TranslucentSheetWindow"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.page.main.github.share.GitHubShareImportActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/github_share_import_activity_title"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.KeiOS.ShareImportWindow">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.page.main.jsonimport.KeiOSJsonImportActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:label="@string/json_import_title">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:mimeType="application/json" />
                <data android:mimeType="text/json" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="application/json" />
                <data android:mimeType="text/json" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.page.main.github.importer.GitHubStarImportActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:enableOnBackInvokedCallback="true"
            android:exported="false"
            android:label="@string/github_star_import_title" />

        <activity
            android:name=".ui.page.main.feedback.FeedbackIssueActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:enableOnBackInvokedCallback="true"
            android:exported="false"
            android:label="@string/feedback_issue_title"
            android:windowSoftInputMode="adjustResize" />



        <activity
            android:name=".ui.page.main.debug.DebugComponentLabActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:label="@string/debug_component_lab_title" />

        <activity
            android:name=".ui.page.main.debug.DebugLiquidCatalogActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:label="@string/debug_component_lab_liquid_catalog_title" />

        <activity
            android:name=".ui.page.main.student.GuideVideoFullscreenActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:enableOnBackInvokedCallback="true"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:taskAffinity="${applicationId}.guideVideoPip">
            <layout
                android:minWidth="@dimen/guide_video_pip_min_width"
                android:minHeight="@dimen/guide_video_pip_min_height" />
        </activity>

        <activity
            android:name=".ui.page.main.student.GuideVideoPictureInPictureActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:enableOnBackInvokedCallback="true"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:taskAffinity="${applicationId}.guideVideoPip">
            <layout
                android:minWidth="@dimen/guide_video_pip_min_width"
                android:minHeight="@dimen/guide_video_pip_min_height" />
        </activity>

        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <service
            android:name=".ui.page.main.student.media.BaGuideBgmMediaSessionService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <service
            android:name=".core.background.GitHubBackgroundRefreshJobService"
            android:enabled="true"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".core.background.WebDavAutoSyncJobService"
            android:enabled="true"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".feature.notification.NotificationActionReceiver"
            android:enabled="true"
            android:exported="false" />

        <!--
            Exported, and MiFocusNotificationActionsTest pins that it stays so.
            Every path that reaches it today is a PendingIntent this app builds
            (MiFocusNotificationActions and McpNotificationInteractionIntents both go through
            PendingIntent.getBroadcast at our own package), and a PendingIntent fires with its
            creator's identity, so on that reading the export is unnecessary and lets any installed app
            trigger a mark-read or dismiss by component name. It is left exported anyway: the HyperOS
            Focus and Super Island delivery path cannot be exercised on a stock emulator, and the cost
            of being wrong is silently dead notification actions on a real device. Unexport it together
            with a HyperOS check, not on static reading alone.
        -->
        <receiver
            android:name=".feature.notification.MiFocusNotificationActionReceiver"
            android:enabled="true"
            android:exported="true" />

        <!-- Same shape: notification actions delivered by our own PendingIntents, no intent-filter. -->
        <receiver
            android:name=".feature.github.notification.GitHubShareImportActionReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".feature.github.install.GitHubShizukuInstallResultReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".core.shortcut.AppShortcutActionReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".core.background.AppBackgroundTickReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".core.background.AppBackgroundSystemEventReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
            Daily-done quick settings tiles.

            android:enabled="false" is the point: a declared tile does not join the QS panel by itself,
            but it does appear in the QS editor's list of available tiles. Shipping them disabled keeps
            them out of that list entirely until the teacher claims one from the BA settings sheet, which
            enables the component and then calls StatusBarManager.requestAddTileService.

            A tile is a manifest component and cannot be created at runtime, so "one tile per account" is
            a fixed pool of three - see BA_DAILY_TILE_SLOTS.
        -->
        <service
            android:name=".core.tile.BaDailyDoneAllTileService"
            android:enabled="false"
            android:exported="true"
            android:label="@string/ba_daily_done_tile_label_all"
            android:icon="@drawable/ic_ba_daily_done_mono"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".core.tile.BaDailyDoneAccountTileService1"
            android:enabled="false"
            android:exported="true"
            android:label="@string/ba_daily_done_tile_label_slot_1"
            android:icon="@drawable/ic_ba_daily_done_mono"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".core.tile.BaDailyDoneAccountTileService2"
            android:enabled="false"
            android:exported="true"
            android:label="@string/ba_daily_done_tile_label_slot_2"
            android:icon="@drawable/ic_ba_daily_done_mono"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".core.tile.BaDailyDoneAccountTileService3"
            android:enabled="false"
            android:exported="true"
            android:label="@string/ba_daily_done_tile_label_slot_3"
            android:icon="@drawable/ic_ba_daily_done_mono"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>
